- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      agent2api:
        displayName: agent2api
        apiKeyEnv: AGENT2API_API_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:3065/v1
        models:
          - id: cn:deepseek-v4.1-flash
            name: cn:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: global:deepseek-v4.1-flash
            name: global:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: trea:deepseek-v4.1-flash
            name: trea:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: glm-5.2
            name: glm-5.2
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: glm-5.3
            name: glm-5.3
            contextWindow: 1000000
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: gemini-3-flash
            name: gemini-3-flash
            input:
              - text
              - image
            contextWindow: 1000000