- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      gcli2api:
        displayName: gcli2api
        apiKeyEnv: GCLI2API_API_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:7861/antigravity/v1
        defaultContextWindow: 1000000
        models:
          - id: gemini-3.8-flash-high
            name: gemini-3.8-flash-high
            contextWindow: 1000000
            input:
              - text
              - image
      agent2api:
        displayName: agent2api
        apiKeyEnv: AGENT2API_API_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:3065/v1
        models:
          - id: cn:deepseek-v4.1-flash
            name: cn:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: global:deepseek-v4.1-flash
            name: global:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: other:deepseek-v4.1-flash
            name: other:deepseek-v4.1-flash
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: tc:glm-5.3
            name: tc:glm-5.3
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              low: low
              high: high
              max: max
          - id: step-5-preview
            name: step-5-preview
            reasoningEfforts:
              off: null
              low: low
              high: high
              max: max
          - id: kimi-k3
            name: kimi-k3
            contextWindow: 1000000
            input:
              - text
              - image
            reasoningEfforts:
              minimal: minimal
              low: low
              medium: medium
              high: high
              xhigh: xhigh
              max: max